# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build
bin
.metals
.fake

*.class

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log
app-node/data/

# Benchmark artifacts (-Dbench=on probes write bench*.txt to their module dir:
# bench.txt, bench-pufferfish.txt, bench-sync.txt)
bench*.txt

# GraalVM native-image output (./gradlew :app-node:nativeImage)
/rhizome-node
/data/
.claude/
.opencode/
CLAUDE.md
AGENTS.md
.specforge/
ideas/
specs/
.testnet/
# Clés de mineur du testnet local : générées par start.sh, écrites EN CLAIR (--plaintext,
# le lancement doit rester non interactif). Sans valeur — devnet jetable — mais une clé
# privée n'a rien à faire dans l'historique du dépôt.
scripts/local-testnet/keys/

# Même règle pour le faucet (scripts/local-testnet/faucet/) : ni la clé jetable que
# suite-faucet.sh génère pour ses propres cas, ni un état persisté qu'un opérateur testerait
# localement, n'ont leur place ici — voir faucet/README.md pour où la clé RÉELLE doit vivre
# (jamais dans ce dépôt, même chiffrée).
scripts/local-testnet/faucet/keys/
scripts/local-testnet/faucet/*.key
scripts/local-testnet/faucet/*state*.json

# Environnement local de shell — peut contenir des secrets ; jamais dans le dépôt.
.env

# Octets compilés des outils Python de scripts/local-testnet/ (faucet.py, tools/*.py) : un
# artefact d'exécution, jamais du code source.
__pycache__/
*.pyc
.staging-rehearsal/
.testnet-deep-reorg/
