# systemd unit for the staging-testnet faucet (scripts/local-testnet/faucet/faucet.py).
#
# faucet.py exists in this repo and every flag below is verified against its argparse
# (parse_args): --node-url, --key-file, --port. The faucet's own RHIZOME_FAUCET_* env vars
# are its argparse defaults; this unit passes the three flags it needs explicitly.
#
# NOT VALIDATED AGAINST A LIVE HOST: only `systemd-analyze verify` was run on this file. The
# install path /opt/rhizome/faucet/faucet.py is an assumed deploy layout, not a repo fact.
#
# Key handling: the faucet's key is loaded via LoadCredential= (see below), so it never sits in
# the process environment. systemd exports the credentials directory to the process as
# $CREDENTIALS_DIRECTORY; the key is at $CREDENTIALS_DIRECTORY/key, and faucet.py reads it via
# --key-file. ExecStart uses the %d specifier (the same directory) because systemd does not
# expand $CREDENTIALS_DIRECTORY in ExecStart command lines.
#
# Install (key only; there is no faucet.env.example in the repo — write /etc/rhizome/faucet.env
# by hand with FAUCET_NODE_URL and FAUCET_LISTEN_PORT):
#   install -d -m 0750 -o root -g root /etc/rhizome
#   install -m 0600 -o root -g root faucet.key /etc/rhizome/faucet.key   # app-wallet keygen file

[Unit]
Description=Rhizome staging-testnet faucet (TEMPLATE — see header, not wired to a real script)
Documentation=https://github.com/rhizome/rhizome
# The faucet talks to a Rhizome node over HTTP to submit funding transactions — it must not
# start racing a node that is not there yet. Same-host convention assumed (After=, not a
# network dependency on a remote node); adjust if faucet and node run on separate hosts.
After=network-online.target rhizome-node.service
Wants=network-online.target
# Wants, not Requires: a node restart must not bounce the faucet (Requires would stop it too).
Wants=rhizome-node.service
# Circuit breaker (belongs on [Unit], not [Service], since systemd 230): if the unit cannot
# stay started across 5 attempts inside 10 minutes, stop trying rather than restart forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple

# FAUCET_NODE_URL and FAUCET_LISTEN_PORT are this unit's own variable names; ExecStart passes
# them as flags (faucet.py's argparse). The key path is NOT in this file — see LoadCredential.
EnvironmentFile=/etc/rhizome/faucet.env

# Key comes from /etc/rhizome/faucet.key, copied into the credentials directory for this unit.
LoadCredential=key:/etc/rhizome/faucet.key

# Python script at an assumed install path (not a repo fact — adjust to the real deploy layout).
ExecStart=/usr/bin/python3 /opt/rhizome/faucet/faucet.py \
    --node-url "${FAUCET_NODE_URL}" \
    --key-file %d/key \
    --port "${FAUCET_LISTEN_PORT}"

Restart=on-failure
RestartSec=5s

# A faucet has no RocksDB/native-store unwind to wait for (unlike rhizome-node.service) — a
# plain HTTP-serving Python process should stop promptly on SIGTERM. Left at a still-generous
# value rather than systemd's 90s default purely for symmetry with the node unit; tighten once
# the real script's shutdown behaviour (does it hold any in-flight signing operation open?) is
# known.
KillSignal=SIGTERM
TimeoutStopSec=30s

# Faucet holds a funded private key (the LoadCredential key) — deliberately its OWN system user, not
# shared with `rhizome` (the node's user in rhizome-node.service), so a compromise of one
# process's filesystem access does not automatically expose the other's secret.
User=rhizome-faucet
Group=rhizome-faucet
StateDirectory=rhizome-faucet
StateDirectoryMode=0750

LimitNOFILE=65536

# No capabilities needed (the port is above 1024); the faucet only talks HTTP to the node.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Same baseline hardening posture as rhizome-node.service — see that unit's trailing comment
# for what is deliberately left out and why.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
