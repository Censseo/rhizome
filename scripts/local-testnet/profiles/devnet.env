# Miroir CHECKÉ des constantes de consensus de NetworkParameters.devnet() — source unique que
# common.sh charge (voir PROFILE_FILE) et que les batteries lisent au lieu de recopier leurs
# propres constantes à la main. TestnetProfileMirrorTest (app-node) confronte CE FICHIER à
# NetworkParameters.devnet() : un profil qui change sans que ce fichier soit régénéré et revu
# fait ÉCHOUER le build, plutôt que de laisser une batterie s'ajuster silencieusement.
#
# Régénéré par ProfileDump — ne pas éditer les valeurs à la main :
#   ./gradlew :app-node:installDist
#   javac -cp app-node/build/install/app-node/lib/'*' -d /tmp/pd scripts/local-testnet/tools/ProfileDump.java
#   java -cp /tmp/pd:app-node/build/install/app-node/lib/'*' ProfileDump --network devnet > scripts/local-testnet/profiles/devnet.env
CHAIN_ID=3
NETWORK_NAME=rhizome-devnet
POW_ALGORITHM=SHA256
DIFFICULTY_LOOKBACK=20
MIN_DIFFICULTY=6
MAX_DIFFICULTY=24
GENESIS_DIFFICULTY=6
DESIRED_BLOCK_TIME_SEC=5
MAX_FUTURE_BLOCK_TIME_SEC=120
MEDIAN_TIME_WINDOW=60
MIN_FEE=0
MAX_REORG_DEPTH=120
MAX_UNCLES_PER_BLOCK=2
UNCLE_MAX_DEPTH=7
PRUNE_FLOOR=248
