# Miroir CHECKÉ des constantes de consensus de NetworkParameters.staging() — voir devnet.env pour
# la provenance et le rôle de ce fichier. Aucune campagne "staging" ne tourne sur cette seule
# machine de développement (chaîne multi-VM par construction) ; ce fichier existe pour que
# TestnetProfileMirrorTest couvre aussi ce profil, pas pour être chargé par une batterie locale.
#
# Régénéré par ProfileDump — ne pas éditer les valeurs à la main :
#   ./gradlew :app-node:installDist
#   javac -cp app-node/build/install/app-node/lib/'*' -d /tmp/pd scripts/local-testnet/tools/ProfileDump.java
#   java -cp /tmp/pd:app-node/build/install/app-node/lib/'*' ProfileDump --network staging > scripts/local-testnet/profiles/staging.env
CHAIN_ID=4
NETWORK_NAME=rhizome-staging
POW_ALGORITHM=PUFFERFISH2
DIFFICULTY_LOOKBACK=60
MIN_DIFFICULTY=8
MAX_DIFFICULTY=255
GENESIS_DIFFICULTY=8
DESIRED_BLOCK_TIME_SEC=5
MAX_FUTURE_BLOCK_TIME_SEC=15
MEDIAN_TIME_WINDOW=60
MIN_FEE=10
MAX_REORG_DEPTH=120
MAX_UNCLES_PER_BLOCK=2
UNCLE_MAX_DEPTH=7
PRUNE_FLOOR=248
