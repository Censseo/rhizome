# Example environment file for rhizome-node.service (systemd EnvironmentFile=) or
# `docker run --env-file`. Rhizome has NO config file of its own — every setting here is read
# directly from the process environment by NodeConfig.fromEnv() (app-node/src/main/java/
# rhizome/node/NodeConfig.java); this file is just a place to put that environment where
# systemd/Docker can source it, so it follows systemd's EnvironmentFile syntax: KEY=value per
# line, no quoting, no `export`, `#` comments allowed.
#
# Copy this file to /etc/rhizome/node.env (mode 0640, owned root:rhizome — it can hold bearer
# tokens), fill in the values marked REQUIRED below, and delete or leave commented anything you
# want NodeConfig's built-in default for. The full authoritative list (with the exact default
# and validation each one gets) is NodeConfig's field-by-field Javadoc and README.md's "Run a
# node" table — this file mirrors both; if they and this file ever disagree, they win.
#
# Every variable below is optional to NodeConfig itself (it has a default for all of them) —
# "REQUIRED" in a comment means "required for a node that is actually reachable from the
# public internet as a staging testnet", not "required for NodeConfig to parse".

# ------------------------------------------------------------------------------------------
# Network identity
# ------------------------------------------------------------------------------------------

# REQUIRED. mainnet | testnet | devnet | staging. Unrecognised values are a hard startup
# failure by design (NodeConfig.parseNetwork) — a typo must never silently start you on
# mainnet. "staging" is the mainnet-faithful public network this deploy/ directory targets;
# its pinned genesis allocation (lib-core/src/main/resources/genesis/rhizome-staging.json) is
# already compiled into the jar/native image — you do not need to fetch or mount it
# separately, and RHIZOME_SNAPSHOT below should normally stay unset for this network.
RHIZOME_NETWORK=staging

# HTTP API port. Must match the port your reverse proxy (see nginx-rhizome.conf.example)
# proxies to, and the port your firewall/security-group opens if you bind non-loopback below.
RHIZOME_PORT=3000

# HTTP API bind address. Default (when unset) is 127.0.0.1 — loopback-only. Leave it at
# 127.0.0.1 and put nginx-rhizome.conf.example (TLS termination) in front, OR set it to
# 0.0.0.0 directly ONLY if you also set RHIZOME_API_TOKEN or RHIZOME_ALLOW_OPEN_API=true below
# (the node refuses a public bind with neither — audit H-2). The reverse-proxy path is the one
# this deploy/ directory is built around: it is what lets RHIZOME_TRUST_XFF (further down) be
# safe to turn on.
#RHIZOME_BIND_ADDRESS=127.0.0.1

# RocksDB data directory. LEFT COMMENTED because the right value depends on which of this
# file's two documented uses applies:
#   - systemd (rhizome-node.service): UNCOMMENT and set to /var/lib/rhizome-node, matching
#     that unit's StateDirectory=rhizome-node (systemd materialises that path, mode 0750,
#     owned by the service user) — change both together if you change either.
#   - `docker run --env-file`: leave this commented. app-node/Dockerfile's runtime stage
#     already sets RHIZOME_DATA=/data itself and declares /data as the VOLUME; an active line
#     here would OVERRIDE that (docker run --env-file wins over an image's own ENV) and point
#     the node at a path with no volume behind it, so data would not survive container
#     recreation.
#RHIZOME_DATA=/var/lib/rhizome-node

# ------------------------------------------------------------------------------------------
# Access control — READ THIS SECTION BEFORE EXPOSING THE PORT PUBLICLY
# ------------------------------------------------------------------------------------------

# REQUIRED for any node reachable outside your own host/VPC. When set, state-changing/operator
# routes (/add_peer, /scan/register, /scan/deregister, /add_transaction, /submit,
# /call_readonly) require `Authorization: Bearer <token>`; P2P protocol endpoints stay open so
# peering keeps working. Generate with e.g. `openssl rand -hex 32`. Never logged, never sent
# to a peer (see RHIZOME_PEER_TOKEN below, which is the OUTBOUND counterpart).
#RHIZOME_API_TOKEN=

# REQUIRED alongside RHIZOME_API_TOKEN on every node of a multi-node deployment: the bearer
# token THIS node presents on OUTBOUND peer requests (gossip /submit & /add_transaction, PEX
# fetch/announce, sync GETs). Sent ONLY to the hosts named in RHIZOME_PEERS below, and ONLY
# over `https://` — a peer learned via unauthenticated /add_peer or PEX, or reached over plain
# `http://`, never receives it (so configure RHIZOME_PEERS with https:// URLs, or this token
# never leaves the process and cross-node pushes get refused with 401). Without it, once any
# peer in the cluster sets RHIZOME_API_TOKEN, gossip between nodes stops converging.
#RHIZOME_PEER_TOKEN=

# Extends RHIZOME_API_TOKEN's bearer gate to EVERY route, including reads (default: reads
# stay open, only state-changing routes are gated). The static SPA/docs shell (/, /dashboard/*,
# /docs/*) stays reachable regardless, so a browser can still load the explorer UI; its own API
# fetches carry the token. Turns this into a private-node/private-explorer posture rather than
# a public staging explorer — leave unset (false) for a public staging testnet, where the
# point is that anyone can read the chain.
#RHIZOME_PROTECT_READS=false

# Permits a non-loopback RHIZOME_BIND_ADDRESS with NO RHIZOME_API_TOKEN set — a pure open
# relay posture. Prefer setting RHIZOME_API_TOKEN instead; only use this if you deliberately
# want an unauthenticated public node (e.g. a read-only public explorer mirror) and understand
# every operator route is then open to the network.
#RHIZOME_ALLOW_OPEN_API=false

# DANGEROUS unless the port this node listens on can be reached ONLY through your trusted
# reverse proxy (nginx-rhizome.conf.example, bound to loopback). When true, per-client rate
# limits, push-strike tables and scan ownership key on the FIRST hop of the X-Forwarded-For
# header instead of the TCP socket address. If the node's own port is directly reachable — no
# firewall, no loopback-only bind — a client can forge this header and evade every per-IP
# limit the node has (README.md's own words: "Dangerous when the port is directly reachable —
# clients could spoof the header to evade per-IP limits; enable only when the socket can
# solely be reached from the trusted proxy"). See nginx-rhizome.conf.example for the proxy
# configuration this setting assumes (it OVERWRITES X-Forwarded-For with the real client
# address rather than appending to whatever the client sent — get that wrong and this setting
# is actively worse than leaving it off).
#RHIZOME_TRUST_XFF=false

# Comma-separated extra Host authorities for the DNS-rebinding guard — add your public
# hostname here (e.g. the one nginx-rhizome.conf.example terminates TLS for) as `name` or
# `name:port`, matching what nginx forwards as the Host header. Default already includes
# loopback names, RHIZOME_ADVERTISE's host, and discovered LAN addresses. The literal value
# `off` disables the allowlist entirely (only the Origin/marker CSRF guard remains) — not
# recommended for a public node.
#RHIZOME_ALLOWED_HOSTS=

# ------------------------------------------------------------------------------------------
# Peering / identity
# ------------------------------------------------------------------------------------------

# Public URL this node advertises to peers (must be an http(s) URL with a host — a malformed
# value silently breaks self-pairing refusal, PEX, and the Host allowlist, so it is validated
# at startup). Set this to the externally reachable URL, e.g. the nginx TLS front door.
#RHIZOME_ADVERTISE=https://node.example.org

# Comma-separated seed peer base URLs to bootstrap discovery from. At least one is needed to
# join an existing network rather than starting an isolated chain-of-one.
#RHIZOME_PEERS=

# "snap" bootstraps this node from a peer's state snapshot instead of replaying every block
# from genesis — much faster for joining an established chain late. Leave unset to replay.
#RHIZOME_SYNC=

# ------------------------------------------------------------------------------------------
# Mining / production
# ------------------------------------------------------------------------------------------

# Reward address. If unset, this node does not produce blocks (sync/relay-only). Generate a
# wallet keyfile with `./gradlew :app-wallet:run --args="keygen <keyfile>"`, then
# `./gradlew :app-wallet:run --args="address <keyfile>"` for this value.
#RHIZOME_MINER=

# Producer pacing override, in ms — LOCAL DEVNETS ONLY. This does NOT move the difficulty
# retarget's target block time; pacing far below the network's real desiredBlockTimeSec makes
# every retarget window look artificially fast and difficulty runs away until the chain
# stalls. Do not set this for a staging/public node — leave it unset so the node paces to the
# network's real target.
#RHIZOME_BLOCK_INTERVAL_MS=

# This miner's vote on the protocol's votable parameters, in [-2, 2] (0 abstain, ±1
# storageFeeFactor, ±2 minValuePerByte). Leave at the default (0, abstain) unless you have a
# specific reason to vote.
#RHIZOME_VOTE=0

# ------------------------------------------------------------------------------------------
# Storage / retention
# ------------------------------------------------------------------------------------------

# Path to a LedgerSnapshot JSON file seeding genesis balances. Leave UNSET for RHIZOME_NETWORK
# above set to `staging` (or `mainnet`) — both load their shipped, pinned genesis allocation
# automatically; only override this if you specifically need a different seed (e.g. a custom
# devnet allocation).
#RHIZOME_SNAPSHOT=

# Block bodies to retain; 0 or unset = archive (keep every body forever). A positive value
# must clear a safety floor derived from the network's reorg/uncle/difficulty/median-time
# windows plus margin (NodeConfig.parseKeepBlocks rejects anything lower at startup) — do not
# guess a small number. Leave unset (archive) unless disk footprint is a proven problem.
#RHIZOME_PRUNE=0

# Blocks between state-snapshot materialisations (used for RHIZOME_SYNC=snap bootstrapping by
# other nodes); 0 = never. Default ~17280 (about one per day at 5s blocks).
#RHIZOME_SNAPSHOT_EVERY=17280

# Opt out of the SSRF host filter so this node may peer over loopback/private IPs learned via
# PEX. LOCAL DEVNETS ONLY — leave false/unset for a public staging node. Configured seed peers
# (RHIZOME_PEERS above) bypass the filter regardless of this setting.
#RHIZOME_ALLOW_PRIVATE_PEERS=false
